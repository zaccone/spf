    {
      "description": "",
      "tests": {
        "empty": {
          "comment": "test empty\n",
          "helo": "mail1.example1.com",
          "host": "1.2.3.4",
          "mailfrom": "foo@example1.com",
          "result": [
            "neutral"
          ]
        },
        "nospace1": {
          "comment": "test no space\ntest multi-line comment\n",
          "helo": "mail.example1.com",
          "host": "1.2.3.4",
          "mailfrom": "foo@example2.com",
          "result": [
            "none"
          ]
        },
        "nospace2": {
          "helo": "mail.example1.com",
          "host": "1.2.3.4",
          "mailfrom": "foo@example3.com",
          "result": [
            "pass"
          ]
        }
      },
      "zone": {
        "example1.com": [
          {
            "text": [
              "v=spf1"
            ],
            "type": "TXT"
          }
        ],
        "example2.com": [
          {
            "text": [
              "v=spf1mx"
            ],
            "type": "TXT"
          }
        ],
        "example3.com": [
          {
            "text": [
              "v=spf1",
              "mx"
            ],
            "type": "TXT"
          },
          {
            "text": [
              "v=spf1 ",
              "mx"
            ],
            "type": "TXT"
          },
          {
            "preference": 0,
            "type": "MX",
            "value": "mail.example1.com"
          }
        ],
        "mail.example1.com": [
          {
            "type": "A",
            "value": "1.2.3.4"
          }
        ]
      }
    },
    {
      "description": "corner cases\n",
      "tests": {
        "cname-chain": {
          "comment": "pyspf was duplicating TXT (and other) records while following CNAME\n",
          "helo": "mail.example.com",
          "host": "1.2.3.4",
          "mailfrom": "foo@e2.example.com",
          "result": [
            "pass"
          ]
        },
        "default-modifier": {
          "comment": "default modifier implemented in lax mode for compatibility\n",
          "helo": "mail.example.com",
          "host": "1.2.3.4",
          "mailfrom": "root@e1.example.com",
          "result": [
            "fail"
          ],
          "strict": 0
        },
        "default-modifier-harsh": {
          "comment": "default modifier implemented in lax mode for compatibility\n",
          "helo": "mail.example.com",
          "host": "1.2.3.4",
          "mailfrom": "root@e1.example.com",
          "result": [
            "ambiguous"
          ],
          "strict": 2
        },
        "emptyMX": {
          "comment": "test empty MX\n",
          "helo": "mail.example.com",
          "host": "1.2.3.4",
          "mailfrom": "",
          "result": [
            "neutral"
          ]
        },
        "localhost": {
          "helo": "mail.example.com",
          "host": "127.0.0.1",
          "mailfrom": "root@example.com",
          "result": [
            "fail"
          ]
        },
        "null-cname": {
          "comment": "pyspf was getting a type error for null CNAMEs\nThanks to Kazuhiro Ogura <kazuhiro.ogura@hde.co.jp>\n",
          "helo": "mail.example.com",
          "host": "1.2.3.4",
          "mailfrom": "bar@e3.example.com",
          "result": [
            "softfail"
          ]
        }
      },
      "zone": {
        "c1.example.com": [
          {
            "type": "CNAME",
            "value": "c2.example.com."
          }
        ],
        "c2.example.com": [
          {
            "text": [
              "v=spf1 a a:c1.example.com -all"
            ],
            "type": "TXT"
          },
          {
            "type": "A",
            "value": "1.2.3.4"
          }
        ],
        "e1.example.com": [
          {
            "text": [
              "v=spf1 default=-"
            ],
            "type": "TXT"
          }
        ],
        "e2.example.com": [
          {
            "type": "CNAME",
            "value": "c1.example.com."
          }
        ],
        "e3.example.com": [
          {
            "text": [
              "v=spf1 a:mx1.example.com mx:mx1.example.com ~all"
            ],
            "type": "TXT"
          }
        ],
        "example.com": [
          {
            "text": [
              "v=spf1 -all"
            ],
            "type": "TXT"
          }
        ],
        "mail.example.com": [
          {
            "preference": 0,
            "type": "MX",
            "value": ""
          },
          {
            "text": [
              "v=spf1 mx"
            ],
            "type": "TXT"
          }
        ],
        "mx1.example.com": [
          {
            "type": "CNAME",
            "value": ""
          }
        ]
      }
    }
