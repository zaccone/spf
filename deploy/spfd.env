# /etc/default/spfd — systemd EnvironmentFile syntax, not a shell script.
SPFD_DNS=127.0.0.1:5335
SPFD_LISTEN=127.0.0.1:10023
# Set to the receiving MTA's fully qualified hostname before deployment.
SPFD_RECEIVER=mail.example.com
SPFD_TIMEOUT=20s
SPFD_MAX_CHECKS=64
SPFD_MAX_CONNECTIONS=256
# Empty means monitor mode. Set to -enforce after reviewing logs.
SPFD_ENFORCE=
