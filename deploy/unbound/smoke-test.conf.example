# Temporary offline acceptance fixture. Install as spfd-smoke-test.conf in
# /etc/unbound/unbound.conf.d/, then remove after verification.
server:
    local-zone: "spf-deploy.test." static
    local-data: 'pass.spf-deploy.test. 60 IN TXT "v=spf1 ip4:192.0.2.0/24 -all"'
    local-data: 'fail.spf-deploy.test. 60 IN TXT "v=spf1 -all"'
